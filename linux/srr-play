#!/bin/sh
# srr-play           show settings, then start Sega Rally Revo
# srr-play --play    start with saved settings
# srr-play stop      end the game
# srr-play status    running or idle
#
# The session, lock, GPU choice and prefix handling come from the shared
# rea-launcher-sdk play library (rea-play.sh). What this game wires up on
# top (each line was a real hurdle on the reference host — see
# docs/RESEARCH.md):
#  - a private Wine prefix at ~/.local/share/srr-launcher/prefix
#  - Wine's SDL controller bridge for this game (Map Controllers=1) and
#    duplicate raw-input devices disabled (winebus registry)
#  - optional winetricks d3dx9/directplay/d3dcompiler_47 when winetricks is
#    installed (the offline DirectX runtime equivalents that stop this
#    game's main-menu access violation)
#  - the NVIDIA Vulkan ICD pinned on hybrid-GPU hosts with an NVIDIA card,
#    so DXVK cannot land on the integrated GPU (a black screen)
#  - no gamescope of its own: this DXVK title on hybrid hosts routes
#    Vulkan to the iGPU inside gamescope (the Sega Rally Revo lesson);
#    the launcher's isolated Wine desktop handles fullscreen instead
#
# Environment: SRR_PREFIX, SRR_LAUNCHER, SRR_RUN (e.g. "distrobox enter
# gaming --"), SRR_WAIT (the AppImage), SRR_WINETRICKS=off.
set -u

# The library: next to this script in a package, else the vendored copy.
_here=$(dirname "$(readlink -f "$0")")
if [ -f "$_here/rea-play.sh" ]; then
  . "$_here/rea-play.sh"
elif [ -f "$_here/../sdk/rea-play.sh" ]; then
  . "$_here/../sdk/rea-play.sh"
elif [ -n "${SRR_PLAY_FUNCTIONS_ONLY:-}" ] && [ -f "$_here/../../sdk/rea-play.sh" ]; then
  . "$_here/../../sdk/rea-play.sh"   # sourced by linux/tests/*.sh
else
  echo "rea-play.sh not found next to $0 or in ../sdk (run scripts/sdk-sync)" >&2
  exit 1
fi

REA_APP=srr-launcher
REA_EXE_NAME=SRRLauncher.exe
REA_EXE_HINT=SRR_LAUNCHER
REA_EXE=${SRR_LAUNCHER:-}
REA_PREFIX=${SRR_PREFIX:-}
REA_RUN=${SRR_RUN:-}
REA_WAIT=${SRR_WAIT:-}
REA_ALWAYS_WAIT=0                 # detached unless SRR_WAIT (the AppImage)
REA_CFG_APPDATA=SRRLauncher
REA_GAMESCOPE=off                 # see the header: the isolated Wine desktop instead
REA_GPU_ICD_PIN=1                 # pin NVIDIA's Vulkan ICD on hybrid hosts
REA_PLAY_ARGS="--no-window --linux"
REA_SDL_ENV=SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1
REA_SDL_SETTINGS=0
# The launcher can return before the game (the isolated Wine desktop).
REA_GAME_PROCS='SEGA Rally.exe|SEGA Rally_SSE1'
# The v2 marker replaces an old, misspelled seed: such prefixes are seeded
# again once, prefixes seeded with the right names are not.
REA_WINEBUS_MARKER=.srr-winebus-v2
REA_DIRECT_NOTE="starting (isolated Wine desktop, frame limit via DXVK)"

# The offline DirectX runtime equivalents: the community setup installs
# d3dx9 + directplay (+ d3dcompiler_47 as a DXVK safeguard) to stop a
# repeatable main-menu access violation. Best effort — only when
# winetricks is available; SRR_WINETRICKS=off skips it. Runs under
# rea_once: a skip returns non-zero, so it is tried again next time.
seed_winetricks() {
  [ "${SRR_WINETRICKS:-auto}" = "off" ] && return 1
  rea_run sh -c "command -v winetricks" >/dev/null 2>&1 || {
    echo "note: winetricks not found; if the game crashes at the main menu,"
    echo "install winetricks (d3dx9 directplay d3dcompiler_47) and rerun"
    return 1
  }
  echo "installing d3dx9 directplay d3dcompiler_47 (once)"
  rea_run env WINEPREFIX="$REA_PREFIX" winetricks -q d3dx9 directplay d3dcompiler_47 >/dev/null 2>&1
  return 0
}

# Both the window and the game read pads through Wine's bus, so the prefix
# is prepared before either starts. SRRLauncher.exe seeds the same winebus
# values itself under any Wine/Proton; seeding here as well means the bus
# already starts with them on a brand-new prefix.
bootstrap() {
  rea_seed_winebus
  rea_once .srr-tricks seed_winetricks || true   # skipped: retried next time
}
rea_hook_before_settings() { bootstrap; }
rea_hook_before_start() { bootstrap; }

rea_init || exit 1
# Tests load the configuration and hooks without running anything.
[ -n "${SRR_PLAY_FUNCTIONS_ONLY:-}" ] && return 0
rea_main "$@"
